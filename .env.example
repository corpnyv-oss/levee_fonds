# ====================================
# FAPAG Collecte - Configuration
# ====================================
# Copy this file to .env and update values
# Keep this file secure and never commit .env to version control

# ===== CORE SETTINGS =====
# -------------------------
# Debug mode (True/False)
# In production, this MUST be set to False
DEBUG=False

# Django secret key - generate a long random string
# Generate with: openssl rand -base64 64
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Comma-separated list of allowed host names
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://api.example.com,http://localhost:3000,http://127.0.0.1:3000

# Comma-separated list of CORS allowed origins
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# Session and CSRF cookie settings
SESSION_COOKIE_AGE=1209600  # 2 weeks in seconds
CSRF_COOKIE_SECURE=!DEBUG
SESSION_COOKIE_SECURE=!DEBUG
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# Security headers
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin
SECURE_HSTS_SECONDS=31536000  # 1 year
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_SSL_REDIRECT=!DEBUG

# ===== DATABASE =====
# --------------------
# PostgreSQL Configuration
POSTGRES_DB=fapag_collecte
POSTGRES_USER=fapag_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_HOST=db.internal
POSTGRES_PORT=5432

# ===== CACHE & QUEUE =====
# -------------------------
# Redis URL for Celery and caching
REDIS_URL=redis://redis.internal:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=django-db  # or ${REDIS_URL} for Redis backend

# Celery settings
CELERY_TIMEZONE=Africa/Libreville
CELERY_TASK_TIME_LIMIT=1800  # 30 minutes
CELERY_TASK_SOFT_TIME_LIMIT=1500  # 25 minutes
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ===== STORAGE =====
# -------------------
# Storage type (local, s3)
STORAGE_TYPE=local

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=  # Optional CDN domain
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True

# ===== JWT CONFIGURATION =====
# -----------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_ALGORITHM=HS256
JWT_SLIDING_TOKEN_LIFETIME_MINUTES=5
JWT_SLIDING_REFRESH_LIFETIME_DAYS=1

# ===== EMAIL CONFIGURATION =====
# ------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
EMAIL_SUBJECT_PREFIX=[FAPAG] 

# ===== PAYMENT CONFIGURATION =====
# -------------------------------
# SingPay Settings
SINGPAY_CLIENT_ID=your_client_id
SINGPAY_API_KEY=your_api_key
SINGPAY_SECRET=your_secret
SINGPAY_WEBHOOK_SECRET=your_webhook_secret
SINGPAY_BASE_URL=https://sandbox-api.singpay.com
SINGPAY_RETURN_URL=http://localhost:3000/singpay/success
SINGPAY_CANCEL_URL=http://localhost:3000/singpay/cancel
SINGPAY_TIMEOUT=30
SINGPAY_MAX_RETRIES=3
SINGPAY_RETRY_DELAY=1
SINGPAY_WEBHOOK_IPS=  # Comma-separated list of allowed IPs

# Payment Settings
PAYMENT_MOBILE_MONEY_ENABLED=True
PAYMENT_CREDIT_CARD_ENABLED=True
PAYMENT_BANK_TRANSFER_ENABLED=True
TRANSACTION_TIMEOUT=3600  # 1 hour
MAX_PAYMENT_ATTEMPTS=3
DEFAULT_CURRENCY=XAF
SUPPORTED_CURRENCIES=XAF,EUR,USD
PAYMENT_COMMISSION_RATE=0.015  # 1.5%
FIXED_TRANSACTION_FEE=100  # XAF

# ===== SECURITY =====
# -------------------
# Axes (Brute Force Protection)
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# Content Security Policy
CSP_ENABLED=True
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:
CSP_FONT_SRC='self' data:

# ===== MONITORING =====
# ---------------------
# Sentry DSN (for error tracking)
SENTRY_DSN=your_sentry_dsn

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=UA-XXXXX-Y

# ===== FEATURE FLAGS =====
# ------------------------
ENABLE_MAINTENANCE_MODE=False
ENABLE_REGISTRATION=True
ENABLE_EMAIL_VERIFICATION=True
ENABLE_TWO_FACTOR=False
# -------------------
# AWS S3 Configuration (for media files)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=fapag-collecte-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True

# ===== EMAIL =====
# -----------------
# SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=errors@example.com

# ===== PAYMENT GATEWAY =====
# ---------------------------
# SingPay Configuration
SINGPAY_CLIENT_ID=
SINGPAY_API_KEY=
SINGPAY_SECRET=
SINGPAY_WEBHOOK_SECRET=
SINGPAY_BASE_URL=https://sandbox-api.singpay.com
SINGPAY_RETURN_URL=https://app.example.com/singpay/success
SINGPAY_CANCEL_URL=https://app.example.com/singpay/cancel
SINGPAY_ALLOWED_IPS=1.2.3.4,5.6.7.8

# ===== SECURITY =====
# --------------------
# Security settings (auto-configured based on DEBUG)
SECURE_SSL_REDIRECT=!DEBUG
SECURE_HSTS_SECONDS=31536000  # 1 year
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin

# Rate limiting
RATELIMIT_ENABLE=True
RATELIMIT_USE_CACHE=default

# ===== MONITORING =====
# ---------------------
# Sentry DSN (for error tracking)
SENTRY_DSN=

# ===== LOCALIZATION =====
# -----------------------
# Time zone (e.g., Africa/Libreville)
TIME_ZONE=Africa/Libreville

# Language code (e.g., fr-fr, en-us)
LANGUAGE_CODE=fr-fr

# ===== FEATURE FLAGS =====
# ------------------------
# Enable/disable features as needed
ENABLE_MAINTENANCE_MODE=False
ENABLE_SIGNUP=True
ENABLE_EMAIL_VERIFICATION=True
