# ====================================
# FAPAG Collecte - Configuration
# ====================================
# Copiez ce fichier en .env et mettez à jour les valeurs
# Gardez ce fichier sécurisé et ne le committez jamais dans le contrôle de version

# ===== CONFIGURATION DE BASE =====
# ---------------------------------
# Mode debug (True/False)
# En production, DOIT être défini sur False
DEBUG=False

# Clé secrète Django - générez une longue chaîne aléatoire
# Générer avec : openssl rand -base64 64
SECRET_KEY=changez_ceci_par_une_cle_tres_longue_et_securisee

# Liste des hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com

# Fuseau horaire
TIME_ZONE=Europe/Paris

# Langue par défaut
LANGUAGE_CODE=fr-fr

# ===== BASE DE DONNÉES =====
# ---------------------------
# URL de connexion à la base de données Supabase (format: postgresql://user:password@host:port/dbname?options=...)
# Exemple avec Supabase :
DATABASE_URL=postgresql://postgres.gezapnrpbdzwoozrvnjc:VotreMotDePasse@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require&options=statement_timeout=15000ms

# Paramètres avancés de la base de données
DB_CONN_MAX_AGE=600  # Durée de vie des connexions en secondes
DB_SSL_REQUIRE=True  # Force l'utilisation de SSL

# Paramètres spécifiques PostgreSQL (optionnel, déjà inclus dans l'URL)
# DB_CONNECT_TIMEOUT=5
# DB_STATEMENT_TIMEOUT=15000  # en millisecondes
# DB_CLIENT_ENCODING=UTF8

# ===== SÉCURITÉ =====
# --------------------
# Configuration CSRF
CSRF_TRUSTED_ORIGINS=https://api.example.com,http://localhost:3000,http://127.0.0.1:3000
CSRF_COOKIE_SECURE=!DEBUG
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax
CSRF_USE_SESSIONS=False

# Configuration des sessions
SESSION_COOKIE_AGE=1209600  # 2 semaines en secondes
SESSION_COOKIE_SECURE=!DEBUG
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_SAVE_EVERY_REQUEST=False

# En-têtes de sécurité
SECURE_SSL_REDIRECT=!DEBUG
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin
SECURE_HSTS_SECONDS=31536000  # 1 an
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ===== CORS =====
# ----------------
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# ===== FICHIERS STATIQUES ET MÉDIAS =====
# ---------------------------------------
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media
WHITENOISE_MAX_AGE=31536000  # 1 an

# ===== MESSAGERIE =====
# ---------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=webmaster@example.com
SERVER_EMAIL=server@example.com

# ===== CACHE =====
# ----------------
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake

# Configuration Redis (optionnel)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== CELERY =====
# ------------------
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TIMEZONE=${TIME_ZONE}

# ===== ADMINISTRATION =====
# -------------------------
ADMIN_ENABLED=${DEBUG}
ADMIN_URL=admin/

# ===== STOCKAGE AMAZON S3 (optionnel) =====
# ----------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600
AWS_S3_FILE_OVERWRITE=False
AWS_CACHE_MAX_AGE=86400

# ===== SINGPAY PAYMENT GATEWAY =====
# -----------------------------------
# Configuration de l'API SingPay
SINGPAY_CLIENT_ID=votre_client_id
SINGPAY_API_KEY=votre_api_key
SINGPAY_SECRET=votre_secret_key
SINGPAY_WEBHOOK_SECRET=votre_webhook_secret
SINGPAY_BASE_URL=https://sandbox-api.singpay.com  # URL de test, remplacer par l'URL de production en prod
SINGPAY_RETURN_URL=http://localhost:3000/payment/success
SINGPAY_CANCEL_URL=http://localhost:3000/payment/cancel
SINGPAY_TIMEOUT=30  # secondes
SINGPAY_MAX_RETRIES=3
SINGPAY_RETRY_DELAY=1  # secondes
SINGPAY_WEBHOOK_IPS=  # Liste d'IPs autorisées pour les webhooks (séparées par des virgules)
SINGPAY_ALLOWED_IPS=  # Liste d'IPs autorisées pour l'API (séparées par des virgules)

# Frais et commissions
PAYMENT_COMMISSION_RATE=0.015  # 1.5% par défaut
FIXED_TRANSACTION_FEE=100  # 100 XAF par défaut

# ===== JOURNALISATION =====
# ------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
CELERY_RESULT_BACKEND=django-db  # or ${REDIS_URL} for Redis backend

# Celery settings
CELERY_TIMEZONE=Africa/Libreville
CELERY_TASK_TIME_LIMIT=1800  # 30 minutes
CELERY_TASK_SOFT_TIME_LIMIT=1500  # 25 minutes
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ===== STORAGE =====
# -------------------
# Storage type (local, s3)
STORAGE_TYPE=local

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=  # Optional CDN domain
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True

# ===== JWT CONFIGURATION =====
# -----------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_ALGORITHM=HS256
JWT_SLIDING_TOKEN_LIFETIME_MINUTES=5
JWT_SLIDING_REFRESH_LIFETIME_DAYS=1

# ===== EMAIL CONFIGURATION =====
# ------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
EMAIL_SUBJECT_PREFIX=[FAPAG] 

# ===== PAYMENT CONFIGURATION =====
# -------------------------------
# SingPay Settings
SINGPAY_CLIENT_ID=your_client_id
SINGPAY_API_KEY=your_api_key
SINGPAY_SECRET=your_secret
SINGPAY_WEBHOOK_SECRET=your_webhook_secret
SINGPAY_BASE_URL=https://sandbox-api.singpay.com
SINGPAY_RETURN_URL=http://localhost:3000/singpay/success
SINGPAY_CANCEL_URL=http://localhost:3000/singpay/cancel
SINGPAY_TIMEOUT=30
SINGPAY_MAX_RETRIES=3
SINGPAY_RETRY_DELAY=1
SINGPAY_WEBHOOK_IPS=  # Comma-separated list of allowed IPs

# Payment Settings
PAYMENT_MOBILE_MONEY_ENABLED=True
PAYMENT_CREDIT_CARD_ENABLED=True
PAYMENT_BANK_TRANSFER_ENABLED=True
TRANSACTION_TIMEOUT=3600  # 1 hour
MAX_PAYMENT_ATTEMPTS=3
DEFAULT_CURRENCY=XAF
SUPPORTED_CURRENCIES=XAF,EUR,USD
PAYMENT_COMMISSION_RATE=0.015  # 1.5%
FIXED_TRANSACTION_FEE=100  # XAF

# ===== SECURITY =====
# -------------------
# Axes (Brute Force Protection)
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# Content Security Policy
CSP_ENABLED=True
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline' 'unsafe-eval'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_IMG_SRC="'self' data: https:"
CSP_FONT_SRC="'self' data:"

# ===== MONITORING =====
# ---------------------
# Sentry DSN (for error tracking)
SENTRY_DSN=your_sentry_dsn

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=UA-XXXXX-Y

# ===== FEATURE FLAGS =====
# ------------------------
ENABLE_MAINTENANCE_MODE=False
ENABLE_REGISTRATION=True
ENABLE_EMAIL_VERIFICATION=True
ENABLE_TWO_FACTOR=False
# -------------------
# AWS S3 Configuration (for media files)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=fapag-collecte-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True

# ===== EMAIL =====
# -----------------
# SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=errors@example.com

# ===== PAYMENT GATEWAY =====
# ---------------------------
# SingPay Configuration
SINGPAY_CLIENT_ID=
SINGPAY_API_KEY=
SINGPAY_SECRET=
SINGPAY_WEBHOOK_SECRET=
SINGPAY_BASE_URL=https://sandbox-api.singpay.com
SINGPAY_RETURN_URL=https://app.example.com/singpay/success
SINGPAY_CANCEL_URL=https://app.example.com/singpay/cancel
SINGPAY_ALLOWED_IPS=1.2.3.4,5.6.7.8

# ===== SECURITY =====
# --------------------
# Security settings (auto-configured based on DEBUG)
SECURE_SSL_REDIRECT=!DEBUG
SECURE_HSTS_SECONDS=31536000  # 1 year
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin

# Rate limiting
RATELIMIT_ENABLE=True
RATELIMIT_USE_CACHE=default

# ===== MONITORING =====
# ---------------------
# Sentry DSN (for error tracking)
SENTRY_DSN=

# ===== LOCALIZATION =====
# -----------------------
# Time zone (e.g., Africa/Libreville)
TIME_ZONE=Africa/Libreville

# Language code (e.g., fr-fr, en-us)
LANGUAGE_CODE=fr-fr

# ===== FEATURE FLAGS =====
# ------------------------
# Enable/disable features as needed
ENABLE_MAINTENANCE_MODE=False
ENABLE_SIGNUP=True
ENABLE_EMAIL_VERIFICATION=True
